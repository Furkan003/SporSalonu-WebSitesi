<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NFA Spor Merkezi</title>
    <meta name="description" content="NFA Spor Merkezi – Profesyonel eğitim programları ve modern ekipmanlarla sağlıklı yaşam." />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/NfaSporSalonu.styles.css" asp-append-version="true" />

    @* ═══════ Early Dark Mode Init (prevents FOUC) ═══════ *@
    <script>
        (function(){
            var s=localStorage.getItem('nfa-theme');
            var d=s==='dark'||(!s&&window.matchMedia('(prefers-color-scheme:dark)').matches);
            if(d){document.documentElement.setAttribute('data-bs-theme','dark');document.documentElement.classList.add('dark');}
        })();
    </script>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="nfa-body-flex">
    @* ═══════ Navbar ═══════ *@
    <header>
        <nav class="navbar navbar-expand-lg fixed-top nfa-navbar-glass" id="mainNavbar">
            <div class="container">
                @* Brand *@
                <a class="navbar-brand d-flex align-items-center gap-2 nfa-navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="nfa-navbar-brand-circle">NFA</span>
                    Spor Merkezi
                </a>

                @* Toggler (Hamburger) *@
                <button class="navbar-toggler nfa-navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <span class="nfa-hamburger-icon">
                        <span></span><span></span><span></span>
                    </span>
                </button>

                @* Links *@
                <div class="collapse navbar-collapse nfa-navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav mx-auto gap-1 nfa-nav-links">
                        <li class="nav-item">
                            <a class="nav-link nfa-nav-link px-3" href="/#hero">Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nfa-nav-link px-3" href="/#about">Hakkımızda</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nfa-nav-link px-3" href="/#services">Hizmetler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nfa-nav-link px-3" href="/#products">Ürünler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nfa-nav-link px-3" asp-controller="Home" asp-action="Paketler">Paketler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nfa-nav-link px-3" href="/#contact">İletişim</a>
                        </li>
                    </ul>

                    @* Auth Buttons + Dark Mode Toggle *@
                    <div class="nfa-navbar-actions">
                        @* Dark Mode Toggle *@
                        <div class="nfa-theme-toggle" id="themeToggle" data-active="false" title="Tema Değiştir" role="button" tabindex="0" aria-label="Karanlık mod">
                            <div class="nfa-theme-toggle-knob">
                                <i class="bi bi-sun-fill" id="themeIcon" style="color:#f59e0b;"></i>
                            </div>
                        </div>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* ── Kullanıcı karşılama ── *@
                            <span class="nfa-navbar-user select-none">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                            </span>

                            @* ── Role-specific panel butonu ── *@
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-nfa-primary btn-sm px-2 py-1" style="font-size:.75rem;">
                                    <i class="bi bi-speedometer2 me-1"></i>Yönetim Paneli
                                </a>
                            }
                            else if (User.IsInRole("Trainer"))
                            {
                                <a asp-controller="Trainer" asp-action="Dashboard" class="btn btn-nfa-primary btn-sm px-2 py-1" style="font-size:.75rem;">
                                    <i class="bi bi-clipboard-pulse me-1"></i>Eğitmen Paneli
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Membership" asp-action="Dashboard" class="btn btn-nfa-primary btn-sm px-2 py-1" style="font-size:.75rem;">
                                    <i class="bi bi-grid me-1"></i>Panelim
                                </a>
                            }

                            @* ── Çıkış Yap (kırmızı vurgulu) ── *@
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm px-2 py-1 nfa-navbar-btn-logout" style="font-size:.75rem;">
                                    <i class="bi bi-box-arrow-left me-1"></i>Çıkış Yap
                                </button>
                            </form>
                        }
                        else
                        {
                            @* ── Ziyaretçi: Giriş / Kayıt ── *@
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm px-2 py-1 nfa-navbar-btn-outline" style="font-size:.75rem;">
                                Giriş Yap
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-nfa-primary btn-sm px-2 py-1" style="font-size:.75rem;">
                                Kayıt Ol
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @* ═══════ Main ═══════ *@
    <main role="main" class="nfa-main-grow">
        @RenderBody()
    </main>

    @* ═══════ Footer — always at bottom ═══════ *@
    <footer class="nfa-footer">
        <div class="container text-center">
            <span>&copy; @DateTime.Now.Year NFA Spor Merkezi. Tüm hakları saklıdır.</span>
            <span class="mx-2">|</span>
            <a asp-controller="Home" asp-action="Privacy" class="nfa-footer-link">Gizlilik Politikası</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // ═══════ Dark Mode Toggle ═══════
        (function () {
            const html = document.documentElement;
            const toggle = document.getElementById('themeToggle');
            const icon = document.getElementById('themeIcon');
            const saved = localStorage.getItem('nfa-theme');

            function applyTheme(dark) {
                html.setAttribute('data-bs-theme', dark ? 'dark' : 'light');
                if (dark) html.classList.add('dark'); else html.classList.remove('dark');
                toggle.setAttribute('data-active', dark ? 'true' : 'false');
                icon.className = dark ? 'bi bi-moon-stars-fill' : 'bi bi-sun-fill';
                icon.style.color = dark ? '#a5b4fc' : '#f59e0b';
                localStorage.setItem('nfa-theme', dark ? 'dark' : 'light');
            }

            // Init
            const prefersDark = saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches);
            applyTheme(prefersDark);

            toggle.addEventListener('click', () => {
                const isDark = html.getAttribute('data-bs-theme') === 'dark';
                applyTheme(!isDark);
            });

            toggle.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle.click(); }
            });
        })();

        // ═══════ Mobile Menu — Close on link click ═══════
        (function () {
            const navCollapse = document.getElementById('navbarMain');
            if (!navCollapse) return;
            const bsCollapse = new bootstrap.Collapse(navCollapse, { toggle: false });
            navCollapse.querySelectorAll('.nfa-nav-link').forEach(link => {
                link.addEventListener('click', () => {
                    if (window.innerWidth < 992 && navCollapse.classList.contains('show')) {
                        bsCollapse.hide();
                    }
                });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
