<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NFA Yönetim Paneli</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/custom-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        /* ═══════ Admin Dark Mode ═══════ */
        :root {
            --admin-bg: #0a0a0a;
            --admin-card: #141414;
            --admin-border: rgba(255,255,255,.08);
            --admin-fg: #e8e8e8;
            --admin-muted: rgba(255,255,255,.45);
            --admin-sidebar-bg: #111111;
            --admin-accent: oklch(0.795 0.184 86.047);
        }
        html[data-bs-theme="dark"] body {
            background: var(--admin-bg) !important;
            color: var(--admin-fg) !important;
        }
        /* Sidebar */
        .nfa-admin-sidebar {
            background: var(--admin-sidebar-bg) !important;
            border-right: 1px solid var(--admin-border) !important;
        }
        .nfa-admin-sidebar .nav-link {
            color: rgba(255,255,255,.7) !important;
        }
        .nfa-admin-sidebar .nav-link:hover,
        .nfa-admin-sidebar .nav-link.active {
            background: rgba(255,255,255,.08) !important;
            color: var(--admin-accent) !important;
        }
        /* Cards */
        .card, .card-nfa-shadow, .card-nfa-shadow-lg {
            background: var(--admin-card) !important;
            border-color: var(--admin-border) !important;
            color: var(--admin-fg) !important;
        }
        .nfa-stat-card {
            background: var(--admin-card) !important;
            border: 1px solid var(--admin-border) !important;
        }
        /* Form controls */
        .form-control, .form-select, .form-control-nfa {
            background: rgba(255,255,255,.05) !important;
            border-color: var(--admin-border) !important;
            color: var(--admin-fg) !important;
        }
        .form-control:focus, .form-select:focus {
            background: rgba(255,255,255,.08) !important;
            border-color: var(--admin-accent) !important;
            color: var(--admin-fg) !important;
            box-shadow: 0 0 0 3px oklch(0.795 0.184 86.047 / .15) !important;
        }
        .form-control::placeholder { color: rgba(255,255,255,.35) !important; }
        /* Tables */
        .table { color: var(--admin-fg) !important; --bs-table-bg: transparent !important; }
        .table th { border-color: var(--admin-border) !important; color: var(--admin-muted) !important; }
        .table td { border-color: var(--admin-border) !important; }
        .table-striped > tbody > tr:nth-of-type(odd) { --bs-table-striped-bg: rgba(255,255,255,.03) !important; }
        /* Modals */
        .modal-content {
            background: var(--admin-card) !important;
            border: 1px solid var(--admin-border) !important;
            color: var(--admin-fg) !important;
        }
        .modal-header { border-color: var(--admin-border) !important; }
        .modal-footer { border-color: var(--admin-border) !important; }
        .btn-close { filter: invert(1) !important; }
        /* Alerts */
        .alert { border-color: var(--admin-border) !important; }
        /* Misc */
        .text-nfa-muted, .stat-label { color: var(--admin-muted) !important; }
        .nfa-admin-content { color: var(--admin-fg) !important; }
        a:not(.btn):not(.nav-link) { color: var(--admin-accent); }
        hr { border-color: var(--admin-border) !important; }
        /* Badge overrides for dark */
        .badge-nfa-pending { background: oklch(0.795 0.184 86.047 / .15) !important; color: oklch(0.795 0.184 86.047) !important; }
        .badge-nfa-active { background: oklch(0.62 0.18 250 / .15) !important; color: oklch(0.72 0.18 250) !important; }
        .badge-nfa-completed { background: oklch(0.55 0.17 155 / .15) !important; color: oklch(0.72 0.17 155) !important; }
        .badge-nfa-expired { background: oklch(0.6271 0.1936 33 / .15) !important; color: oklch(0.72 0.19 33) !important; }
        /* Sidebar brand area */
        .nfa-admin-sidebar .nfa-auth-brand {
            background: var(--admin-accent) !important;
            color: #000 !important;
        }
    </style>
</head>
<body>

    @* ═══════ Sidebar ═══════ *@
    <aside class="nfa-admin-sidebar d-flex flex-column" id="adminSidebar">
        @* Brand *@
        <div class="px-4 py-3 d-flex align-items-center gap-2" style="border-bottom:1px solid var(--admin-border);">
            <span class="nfa-auth-brand" style="width:40px;height:40px;font-size:1rem;margin-bottom:0;">NFA</span>
            <span class="fw-bold" style="font-size:1.05rem;">Yönetim Paneli</span>
        </div>

        @* Navigation *@
        <nav class="flex-grow-1 p-3">
            <ul class="nav flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2"
                       asp-controller="Admin" asp-action="Dashboard">
                        <i class="bi bi-speedometer2"></i> Kontrol Paneli
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2"
                       asp-controller="Admin" asp-action="Users">
                        <i class="bi bi-people"></i> Kullanıcılar
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2"
                       asp-controller="Admin" asp-action="Payments">
                        <i class="bi bi-cash-stack"></i> Ödemeler
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2"
                       asp-controller="Trainer" asp-action="Index">
                        <i class="bi bi-person-badge"></i> Eğitmenler
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2"
                       asp-controller="Trainer" asp-action="Programs">
                        <i class="bi bi-journal-text"></i> Programlar
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2"
                       asp-controller="Admin" asp-action="Notifications">
                        <i class="bi bi-bell"></i> Bildirimler
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2"
                       asp-controller="Admin" asp-action="SupportTickets">
                        <i class="bi bi-headset"></i> Destek Talepleri
                    </a>
                </li>
            </ul>
        </nav>

        @* Footer *@
        <div class="p-3" style="border-top:1px solid var(--admin-border);">
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-nfa-outline w-100 d-flex align-items-center justify-content-center gap-2" style="font-size:.875rem;">
                    <i class="bi bi-box-arrow-left"></i> Çıkış Yap
                </button>
            </form>
        </div>
    </aside>

    @* ═══════ Main Content ═══════ *@
    <div class="nfa-admin-content">
        @* Top Bar *@
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-nfa-outline d-lg-none p-2" type="button" onclick="document.getElementById('adminSidebar').classList.toggle('show')">
                    <i class="bi bi-list" style="font-size:1.25rem;"></i>
                </button>
                <h4 class="fw-bold mb-0">@ViewData["Title"]</h4>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span style="font-size:.8125rem;color:var(--admin-muted);">
                    <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                </span>
            </div>
        </div>

        @* ── TempData Alerts ── *@
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-nfa alert-nfa-success d-flex align-items-center alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <span>@TempData["Success"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-nfa alert-nfa-error d-flex align-items-center alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span>@TempData["Error"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }

        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
