@model InvoiceViewModel
@{
    ViewData["Title"] = "Fatura Detay";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4 nfa-no-print">
    <a asp-action="Users" class="btn btn-nfa-outline btn-sm px-3">
        <i class="bi bi-arrow-left me-1"></i>Kullanıcılara Dön
    </a>
    <button onclick="window.print()" class="btn btn-nfa-primary btn-sm px-3">
        <i class="bi bi-printer me-1"></i>Yazdır
    </button>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-nfa-shadow-lg nfa-animate-in" style="border-radius:calc(var(--nfa-radius) * 2);overflow:hidden;">
            @* Fatura Header *@
            <div style="background:linear-gradient(135deg, var(--nfa-secondary) 0%, oklch(0.4 0.02 286) 100%);padding:2rem;color:#fff;">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h4 class="fw-bold mb-1">NFA Spor Merkezi</h4>
                        <p style="opacity:.7;font-size:.8125rem;margin-bottom:0;">Fatura / Makbuz</p>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold" style="font-size:1rem;">@Model.InvoiceNumber</div>
                        <div style="opacity:.7;font-size:.8125rem;">@Model.InvoiceDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</div>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                @* Müşteri Bilgileri *@
                <div class="mb-4 p-3 rounded" style="background:var(--nfa-muted);border:1px solid var(--nfa-border);">
                    <h6 class="fw-semibold mb-2" style="font-size:.875rem;">
                        <i class="bi bi-person me-1" style="color:var(--nfa-primary);"></i>Müşteri Bilgileri
                    </h6>
                    <div class="row" style="font-size:.875rem;">
                        <div class="col-sm-6 mb-2">
                            <span class="text-nfa-muted">Ad Soyad:</span>
                            <div class="fw-semibold">@Model.FullName</div>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <span class="text-nfa-muted">E-posta:</span>
                            <div class="fw-semibold">@Model.Email</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-nfa-muted">Telefon:</span>
                            <div class="fw-semibold">@(Model.PhoneNumber ?? "–")</div>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-nfa-muted">Durum:</span>
                            <div>
                                @if (Model.MembershipStatus == "Aktif")
                                {
                                    <span class="badge badge-nfa-active rounded-pill px-2 py-1">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge badge-nfa-expired rounded-pill px-2 py-1">@Model.MembershipStatus</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @* Üyelik Detayları — Tablo *@
                <div class="table-responsive mb-4">
                    <table class="table table-nfa mb-0">
                        <thead>
                            <tr>
                                <th>Açıklama</th>
                                <th>Süre</th>
                                <th>Başlangıç</th>
                                <th>Bitiş</th>
                                <th class="text-end">Tutar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PlanName != null)
                            {
                                <tr>
                                    <td class="fw-semibold">@Model.PlanName</td>
                                    <td>@(Model.DurationInDays) gün</td>
                                    <td>@Model.MembershipStartDate?.ToString("dd.MM.yyyy")</td>
                                    <td>@Model.MembershipEndDate?.ToString("dd.MM.yyyy")</td>
                                    <td class="text-end fw-bold">@Model.PlanPrice?.ToString("C2", new System.Globalization.CultureInfo("tr-TR"))</td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-nfa-muted py-3">
                                        <i class="bi bi-inbox me-1"></i>Aktif üyelik bulunamadı.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Toplam *@
                @if (Model.PlanPrice != null)
                {
                    <div class="d-flex justify-content-end">
                        <div class="text-end">
                            <div class="d-flex justify-content-between gap-5 mb-1" style="font-size:.875rem;">
                                <span class="text-nfa-muted">Ara Toplam:</span>
                                <span class="fw-semibold">@Model.PlanPrice?.ToString("C2", new System.Globalization.CultureInfo("tr-TR"))</span>
                            </div>
                            <div class="d-flex justify-content-between gap-5 mb-2" style="font-size:.875rem;">
                                <span class="text-nfa-muted">KDV (%20):</span>
                                <span class="fw-semibold">@((Model.PlanPrice * 0.20m)?.ToString("C2", new System.Globalization.CultureInfo("tr-TR")))</span>
                            </div>
                            <hr style="border-color:var(--nfa-border);" />
                            <div class="d-flex justify-content-between gap-5" style="font-size:1.125rem;">
                                <span class="fw-bold">Genel Toplam:</span>
                                <span class="fw-bold" style="color:var(--nfa-primary);">@((Model.PlanPrice * 1.20m)?.ToString("C2", new System.Globalization.CultureInfo("tr-TR")))</span>
                            </div>
                        </div>
                    </div>
                }

                @* Footer Note *@
                <div class="text-center mt-4 pt-3" style="border-top:1px solid var(--nfa-border);">
                    <p class="text-nfa-muted mb-0" style="font-size:.75rem;">
                        Bu belge NFA Spor Merkezi tarafından düzenlenmiştir. • Fatura No: @Model.InvoiceNumber
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
