@model AdminUserListViewModel
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "_AdminLayout";
}

@* ═══════════ ÖZET KARTLARI ═══════════ *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card nfa-stat-card nfa-stat-primary nfa-animate-in">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="stat-icon" style="background:rgba(255,255,255,.2);">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <div class="stat-value">@Model.TotalCount</div>
            <div class="stat-label">Toplam Kullanıcı</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card nfa-stat-card nfa-stat-success nfa-animate-in">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="stat-icon" style="background:rgba(255,255,255,.2);">
                    <i class="bi bi-person-check-fill"></i>
                </div>
            </div>
            <div class="stat-value">@Model.ActiveCount</div>
            <div class="stat-label">Aktif Kullanıcı</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card nfa-stat-card nfa-stat-info nfa-animate-in">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="stat-icon" style="background:rgba(255,255,255,.2);">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
            </div>
            <div class="stat-value">@Model.Users.Count(u => u.RoleName == "Admin")</div>
            <div class="stat-label">Admin</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card nfa-stat-card nfa-stat-warning nfa-animate-in">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="stat-icon" style="background:rgba(0,0,0,.08);">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
            </div>
            <div class="stat-value">@Model.Users.Count(u => u.RoleName == "Trainer")</div>
            <div class="stat-label">Eğitmen</div>
        </div>
    </div>
</div>

@* ═══════════ KULLANICI TABLOSU ═══════════ *@
<div class="card card-nfa-shadow nfa-animate-in">
    <div class="card-body p-0">
        <div class="px-4 pt-4 pb-2 d-flex justify-content-between align-items-center">
            <h6 class="nfa-section-title mb-0">Tüm Kullanıcılar</h6>
            <div>
                <input type="text" id="userSearchInput" class="form-control-nfa" placeholder="İsim veya rol ara..." style="width:240px;font-size:.8125rem;padding:.4rem .75rem;" />
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-nfa mb-0" id="usersTable">
                <thead>
                    <tr>
                        <th style="width:5%;">#</th>
                        <th style="width:30%;">Ad Soyad</th>
                        <th style="width:18%;">Rol</th>
                        <th style="width:22%;">Üyelik Bitiş Tarihi</th>
                        <th style="width:25%;text-align:center;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users.Any())
                    {
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td class="text-nfa-muted">@user.UserId</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="nfa-user-avatar-sm">
                                            @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "?")
                                        </div>
                                        <div>
                                            <div class="fw-semibold" style="font-size:.9rem;line-height:1.3;">@user.FullName</div>
                                            <div class="text-nfa-muted" style="font-size:.75rem;">@user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var roleBadgeClass = user.RoleName switch
                                        {
                                            "Admin" => "badge-nfa-role-admin",
                                            "Trainer" => "badge-nfa-role-trainer",
                                            "Member" => "badge-nfa-role-member",
                                            _ => "badge-nfa-role-default"
                                        };
                                    }
                                    <span class="badge rounded-pill px-2 py-1 @roleBadgeClass">
                                        @(user.RoleName ?? "Atanmadı")
                                    </span>
                                </td>
                                <td>
                                    @if (user.HasActiveMembership)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="nfa-membership-dot nfa-membership-dot--active"></span>
                                            <div>
                                                <div class="fw-semibold" style="font-size:.875rem;">@(user.MembershipEndDate?.ToString("dd MMMM yyyy"))</div>
                                                @{
                                                    var daysLeft = (user.MembershipEndDate!.Value - DateTime.Now).Days;
                                                    var urgencyClass = daysLeft <= 7 ? "text-danger" : daysLeft <= 30 ? "text-warning" : "text-nfa-muted";
                                                }
                                                <div class="@urgencyClass" style="font-size:.7rem;font-weight:500;">@daysLeft gün kaldı</div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="nfa-membership-dot nfa-membership-dot--expired"></span>
                                            <span class="text-nfa-muted" style="font-size:.8125rem;">Üyelik yok</span>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2 justify-content-center">
                                        @* ── Rol Değiştir ── *@
                                        <button type="button"
                                                class="btn btn-nfa-action btn-nfa-action--role btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#roleModal"
                                                data-user-id="@user.UserId"
                                                data-user-name="@user.FullName"
                                                data-current-role="@user.RoleId"
                                                title="Rol Değiştir">
                                            <i class="bi bi-person-gear me-1"></i>Rol Değiştir
                                        </button>

                                        @* ── Üyelik Uzat ── *@
                                        <button type="button"
                                                class="btn btn-nfa-action btn-nfa-action--membership btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#membershipModal"
                                                data-user-id="@user.UserId"
                                                data-user-name="@user.FullName"
                                                data-has-membership="@user.HasActiveMembership.ToString().ToLower()"
                                                data-end-date="@(user.MembershipEndDate?.ToString("dd.MM.yyyy") ?? "")"
                                                title="Üyelik Uzat">
                                            <i class="bi bi-calendar-plus me-1"></i>Üyelik Uzat
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-nfa-muted py-4">
                                <i class="bi bi-people me-1"></i>Henüz kayıtlı kullanıcı bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ═══════════ ROL DEĞİŞTİR MODAL ═══════════ *@
<div class="modal fade" id="roleModal" tabindex="-1" aria-labelledby="roleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:var(--nfa-card);border:1px solid var(--nfa-border);border-radius:calc(var(--nfa-radius) * 2);">
            <div class="modal-header" style="border-bottom:1px solid var(--nfa-border);padding:1.25rem 1.5rem;">
                <h5 class="modal-title fw-bold" id="roleModalLabel">
                    <i class="bi bi-person-gear me-2" style="color:var(--nfa-primary);"></i>Rol Değiştir
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form asp-action="ChangeRole" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body" style="padding:1.5rem;">
                    <input type="hidden" name="UserId" id="modalUserId" />

                    <div class="mb-3">
                        <div class="d-flex align-items-center gap-2 mb-3 p-3 rounded" style="background:var(--nfa-muted);border:1px solid var(--nfa-border);">
                            <i class="bi bi-person-circle" style="font-size:1.5rem;color:var(--nfa-primary);"></i>
                            <div>
                                <div class="fw-semibold" id="modalUserName" style="font-size:.9375rem;"></div>
                                <div class="text-nfa-muted" style="font-size:.75rem;">Kullanıcının rolü değiştirilecek</div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size:.875rem;">
                            <i class="bi bi-shield me-1"></i>Yeni Rol
                        </label>
                        <select name="NewRoleId" id="modalRoleSelect" class="form-control-nfa w-100" required>
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <option value="@role.RoleId">@role.RoleName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid var(--nfa-border);padding:1rem 1.5rem;">
                    <button type="button" class="btn btn-nfa-outline btn-sm px-3" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-nfa-primary btn-sm px-4">
                        <i class="bi bi-check-lg me-1"></i>Rolü Güncelle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ═══════════ ÜYELİK UZAT MODAL ═══════════ *@
<div class="modal fade" id="membershipModal" tabindex="-1" aria-labelledby="membershipModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:var(--nfa-card);border:1px solid var(--nfa-border);border-radius:calc(var(--nfa-radius) * 2);">
            <div class="modal-header" style="border-bottom:1px solid var(--nfa-border);padding:1.25rem 1.5rem;">
                <h5 class="modal-title fw-bold" id="membershipModalLabel">
                    <i class="bi bi-calendar-plus me-2" style="color:oklch(0.72 0.19 155);"></i>Üyelik Uzat
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form asp-action="GrantMembership" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body" style="padding:1.5rem;">
                    <input type="hidden" name="UserId" id="membershipModalUserId" />

                    @* Kullanıcı Bilgisi *@
                    <div class="d-flex align-items-center gap-2 mb-3 p-3 rounded" style="background:var(--nfa-muted);border:1px solid var(--nfa-border);">
                        <i class="bi bi-person-circle" style="font-size:1.5rem;color:oklch(0.72 0.19 155);"></i>
                        <div>
                            <div class="fw-semibold" id="membershipModalUserName" style="font-size:.9375rem;"></div>
                            <div class="text-nfa-muted" id="membershipModalStatus" style="font-size:.75rem;"></div>
                        </div>
                    </div>

                    @* Süre Seçimi *@
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size:.875rem;">
                            <i class="bi bi-clock-history me-1"></i>Uzatma Süresi
                        </label>
                        <div class="d-flex gap-2 mt-2">
                            <label class="nfa-duration-option flex-fill">
                                <input type="radio" name="DurationMonths" value="1" class="nfa-duration-radio" checked />
                                <div class="nfa-duration-card">
                                    <div class="nfa-duration-value">1</div>
                                    <div class="nfa-duration-label">Ay</div>
                                </div>
                            </label>
                            <label class="nfa-duration-option flex-fill">
                                <input type="radio" name="DurationMonths" value="3" class="nfa-duration-radio" />
                                <div class="nfa-duration-card">
                                    <div class="nfa-duration-value">3</div>
                                    <div class="nfa-duration-label">Ay</div>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid var(--nfa-border);padding:1rem 1.5rem;">
                    <button type="button" class="btn btn-nfa-outline btn-sm px-3" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-nfa-grant-1 btn-sm px-4">
                        <i class="bi bi-check-lg me-1"></i>Üyeliği Uzat
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Rol Modal – kullanıcı bilgilerini doldur ──
        document.getElementById('roleModal').addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            document.getElementById('modalUserId').value = btn.getAttribute('data-user-id');
            document.getElementById('modalUserName').textContent = btn.getAttribute('data-user-name');
            var currentRole = btn.getAttribute('data-current-role');
            if (currentRole) {
                document.getElementById('modalRoleSelect').value = currentRole;
            }
        });

        // ── Üyelik Modal – kullanıcı bilgilerini doldur ──
        document.getElementById('membershipModal').addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            document.getElementById('membershipModalUserId').value = btn.getAttribute('data-user-id');
            document.getElementById('membershipModalUserName').textContent = btn.getAttribute('data-user-name');

            var hasMembership = btn.getAttribute('data-has-membership') === 'true';
            var endDate = btn.getAttribute('data-end-date');
            var statusEl = document.getElementById('membershipModalStatus');

            if (hasMembership && endDate) {
                statusEl.textContent = 'Mevcut üyelik bitiş: ' + endDate + ' — süre sonuna eklenecek';
                statusEl.style.color = 'oklch(0.5 0.15 155)';
            } else {
                statusEl.textContent = 'Aktif üyelik yok — bugünden başlayacak';
                statusEl.style.color = '';
            }

            // Radyo butonlarını resetle
            document.querySelector('input[name="DurationMonths"][value="1"]').checked = true;
        });

        // ── Tablo arama ──
        document.getElementById('userSearchInput').addEventListener('input', function () {
            var filter = this.value.toLowerCase();
            var rows = document.querySelectorAll('#usersTable tbody tr');
            rows.forEach(function (row) {
                var text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
}

@* ═══════════ SCOPED STYLES ═══════════ *@
<style>
    /* ── Mini avatar ── */
    .nfa-user-avatar-sm {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--nfa-primary), oklch(0.92 0.0651 74.3695));
        color: var(--nfa-primary-fg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .8rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    /* ── Membership status dot ── */
    .nfa-membership-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .nfa-membership-dot--active {
        background: oklch(0.72 0.19 155);
        box-shadow: 0 0 6px oklch(0.72 0.19 155 / .5);
    }

    .nfa-membership-dot--expired {
        background: var(--nfa-muted-fg);
        opacity: .4;
    }

    /* ── Action buttons ── */
    .btn-nfa-action {
        font-size: .75rem;
        font-weight: 600;
        padding: .35rem .75rem;
        border-radius: var(--nfa-radius);
        border: 1px solid transparent;
        transition: all .2s ease;
        white-space: nowrap;
    }

    .btn-nfa-action--role {
        background: oklch(0.62 0.18 250 / .1);
        color: oklch(0.5 0.14 250);
        border-color: oklch(0.62 0.18 250 / .2);
    }

    .btn-nfa-action--role:hover {
        background: oklch(0.62 0.18 250 / .18);
        color: oklch(0.45 0.16 250);
        border-color: oklch(0.62 0.18 250 / .35);
        transform: translateY(-1px);
        box-shadow: 0 3px 8px oklch(0.62 0.18 250 / .15);
    }

    .btn-nfa-action--membership {
        background: oklch(0.72 0.19 155 / .1);
        color: oklch(0.5 0.15 155);
        border-color: oklch(0.72 0.19 155 / .2);
    }

    .btn-nfa-action--membership:hover {
        background: oklch(0.72 0.19 155 / .18);
        color: oklch(0.4 0.15 155);
        border-color: oklch(0.72 0.19 155 / .35);
        transform: translateY(-1px);
        box-shadow: 0 3px 8px oklch(0.72 0.19 155 / .15);
    }

    /* ── Duration selector (radio card) ── */
    .nfa-duration-option {
        cursor: pointer;
        margin: 0;
    }

    .nfa-duration-radio {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .nfa-duration-card {
        text-align: center;
        padding: 1rem;
        border-radius: calc(var(--nfa-radius) * 1.5);
        border: 2px solid var(--nfa-border);
        background: var(--nfa-card);
        transition: all .2s ease;
    }

    .nfa-duration-radio:checked + .nfa-duration-card {
        border-color: oklch(0.72 0.19 155);
        background: oklch(0.72 0.19 155 / .08);
        box-shadow: 0 0 0 3px oklch(0.72 0.19 155 / .15);
    }

    .nfa-duration-card:hover {
        border-color: oklch(0.72 0.19 155 / .5);
    }

    .nfa-duration-value {
        font-size: 1.5rem;
        font-weight: 800;
        line-height: 1;
        color: var(--nfa-fg);
    }

    .nfa-duration-label {
        font-size: .75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: var(--nfa-muted-fg);
        margin-top: .25rem;
    }

    /* ── Dark mode overrides ── */
    .dark .btn-nfa-action--role,
    [data-bs-theme="dark"] .btn-nfa-action--role {
        background: oklch(0.62 0.18 250 / .15);
        color: oklch(0.72 0.14 250);
        border-color: oklch(0.62 0.18 250 / .25);
    }

    .dark .btn-nfa-action--membership,
    [data-bs-theme="dark"] .btn-nfa-action--membership {
        background: oklch(0.72 0.19 155 / .15);
        color: oklch(0.78 0.15 155);
        border-color: oklch(0.72 0.19 155 / .25);
    }
</style>
