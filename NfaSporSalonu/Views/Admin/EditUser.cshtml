@model EditUserViewModel
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-nfa-shadow-lg nfa-animate-in" style="border-radius:calc(var(--nfa-radius) * 2);overflow:hidden;">
            <div style="background:linear-gradient(135deg, var(--nfa-secondary) 0%, oklch(0.4 0.02 286) 100%);padding:1.5rem 2rem;color:#fff;">
                <h5 class="fw-bold mb-1"><i class="bi bi-pencil-square me-2"></i>Kullanıcı Düzenle</h5>
                <p style="opacity:.8;font-size:.8125rem;margin-bottom:0;">Şifre hariç tüm bilgiler güncellenebilir.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="EditUser" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold" style="font-size:.875rem;"></label>
                            <input asp-for="FirstName" class="form-control form-control-nfa" />
                            <span asp-validation-for="FirstName" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold" style="font-size:.875rem;"></label>
                            <input asp-for="LastName" class="form-control form-control-nfa" />
                            <span asp-validation-for="LastName" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold" style="font-size:.875rem;"></label>
                            <input asp-for="Email" class="form-control form-control-nfa" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold" style="font-size:.875rem;"></label>
                            <input asp-for="PhoneNumber" class="form-control form-control-nfa" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Gender" class="form-label fw-semibold" style="font-size:.875rem;"></label>
                            <select asp-for="Gender" class="form-control form-control-nfa">
                                <option value="">Seçiniz</option>
                                <option value="Erkek">Erkek</option>
                                <option value="Kadın">Kadın</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold" style="font-size:.875rem;"></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control form-control-nfa" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="RoleId" class="form-label fw-semibold" style="font-size:.875rem;"></label>
                            <select asp-for="RoleId" class="form-control form-control-nfa">
                                <option value="">Seçiniz</option>
                                @foreach (var role in Model.AvailableRoles)
                                {
                                    <option value="@role.RoleId">@(role.RoleName switch { "Admin" => "Yönetici", "Trainer" => "Eğitmen", "Member" => "Üye", _ => role.RoleName })</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="ProfileImageUrl" class="form-label fw-semibold" style="font-size:.875rem;"></label>
                            <input asp-for="ProfileImageUrl" class="form-control form-control-nfa" placeholder="https://..." />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                                <label class="form-check-label fw-semibold" asp-for="IsActive" style="font-size:.875rem;">Hesap Aktif</label>
                            </div>
                        </div>
                    </div>

                    @* Üyelik Bilgisi (Read-only) *@
                    @if (Model.HasActiveMembership)
                    {
                        <div class="mt-4 p-3 rounded" style="background:var(--nfa-muted);border:1px solid var(--nfa-border);">
                            <h6 class="fw-semibold mb-2" style="font-size:.875rem;">
                                <i class="bi bi-gem me-1" style="color:var(--nfa-primary);"></i>Aktif Üyelik
                            </h6>
                            <div class="d-flex gap-4" style="font-size:.8125rem;">
                                <span><strong>Paket:</strong> @Model.CurrentPlanName</span>
                                <span><strong>Bitiş:</strong> @Model.MembershipEndDate?.ToString("dd.MM.yyyy")</span>
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Users" class="btn btn-nfa-outline px-4">
                            <i class="bi bi-arrow-left me-1"></i>Geri Dön
                        </a>
                        <button type="submit" class="btn btn-nfa-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
