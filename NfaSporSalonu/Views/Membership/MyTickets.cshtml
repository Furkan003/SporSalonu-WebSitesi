@model List<SupportTicketItemDto>
@using NfaSporSalonu.ViewModels
@{
    ViewData["Title"] = "Destek Taleplerim";
    Layout = "_Layout";
}

<section style="padding-top:100px;padding-bottom:60px;min-height:100vh;">
    <div class="container" style="max-width:800px;">

        @* Başlık *@
        <div class="card card-nfa-shadow-lg nfa-animate-in mb-4" style="border-radius:calc(var(--nfa-radius) * 2);overflow:hidden;">
            <div style="background:linear-gradient(135deg, oklch(0.62 0.18 250) 0%, oklch(0.4 0.02 286) 100%);padding:2rem;color:#fff;text-align:center;">
                <i class="bi bi-headset" style="font-size:2.5rem;opacity:.9;"></i>
                <h2 class="fw-bold mt-2 mb-1">Destek Taleplerim</h2>
                <p style="opacity:.8;font-size:.875rem;margin-bottom:0;">Gönderdiğiniz istek, dilek ve şikayetleri buradan takip edebilirsiniz.</p>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-nfa alert-nfa-success d-flex align-items-center alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <span>@TempData["Success"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-nfa alert-nfa-error d-flex align-items-center alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span>@TempData["Error"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @* ── Yeni Talep Oluştur Butonu ── *@
        <div class="d-flex justify-content-end mb-3 nfa-animate-in">
            <button type="button" class="btn btn-nfa-primary px-4" data-bs-toggle="modal" data-bs-target="#createTicketModal">
                <i class="bi bi-plus-circle me-2"></i>Yeni Talep Oluştur
            </button>
        </div>

        @* ── Yeni Talep Modal ── *@
        <div class="modal fade" id="createTicketModal" tabindex="-1" aria-labelledby="createTicketLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content" style="background:var(--nfa-card);border:1px solid var(--nfa-border);">
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold" id="createTicketLabel">
                            <i class="bi bi-pencil-square me-2" style="color:var(--nfa-primary);"></i>Yeni Destek Talebi
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>
                    <form asp-controller="Membership" asp-action="CreateSupportTicket" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ReturnUrl" value="/Membership/MyTickets" />
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label fw-semibold" style="font-size:.875rem;">Kategori</label>
                                <select name="Category" class="form-select form-control-nfa" required style="background-color:#1a1a1a;border:1px solid rgba(255,255,255,.12);color:#fff;">
                                    <option value="" disabled selected style="background:#1a1a1a;color:#999;">Kategori Seçin</option>
                                    <option value="İstek" style="background:#1a1a1a;color:#fff;">İstek</option>
                                    <option value="Dilek" style="background:#1a1a1a;color:#fff;">Dilek</option>
                                    <option value="Şikayet" style="background:#1a1a1a;color:#fff;">Şikayet</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold" style="font-size:.875rem;">Konu</label>
                                <input type="text" name="Subject" class="form-control form-control-nfa" placeholder="Talebinizin konusu" maxlength="200" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold" style="font-size:.875rem;">Mesajınız</label>
                                <textarea name="Message" class="form-control form-control-nfa" rows="4" placeholder="Detaylı açıklama yazın..." maxlength="2000" required style="resize:none;"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer border-0">
                            <button type="button" class="btn btn-nfa-outline btn-sm" data-bs-dismiss="modal">İptal</button>
                            <button type="submit" class="btn btn-nfa-primary btn-sm px-4">
                                <i class="bi bi-send me-1"></i>Gönder
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @* ── Talep Listesi ── *@
        @if (Model.Any())
        {
            <div class="row g-3">
                @foreach (var ticket in Model)
                {
                    var statusBadge = ticket.Status switch
                    {
                        "Bekliyor" => "badge-nfa-pending",
                        "İnceleniyor" => "badge-nfa-active",
                        "Yanıtlandı" => "badge-nfa-completed",
                        "Kapatıldı" => "badge-nfa-expired",
                        _ => "badge-nfa-pending"
                    };
                    var categoryIcon = ticket.Category switch
                    {
                        "İstek" => "bi-lightbulb",
                        "Dilek" => "bi-heart",
                        "Şikayet" => "bi-exclamation-triangle",
                        _ => "bi-chat-dots"
                    };
                    var categoryColor = ticket.Category switch
                    {
                        "İstek" => "oklch(0.72 0.19 155)",
                        "Dilek" => "oklch(0.62 0.18 250)",
                        "Şikayet" => "oklch(0.6271 0.1936 33)",
                        _ => "var(--nfa-primary)"
                    };

                    <div class="col-12 nfa-animate-in">
                        <div class="card card-nfa-shadow" style="border-left:4px solid @categoryColor;">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi @categoryIcon" style="font-size:1.25rem;color:@categoryColor;"></i>
                                        <div>
                                            <h6 class="fw-bold mb-0" style="font-size:.9375rem;">@ticket.Subject</h6>
                                            <small class="text-nfa-muted">@ticket.Category</small>
                                        </div>
                                    </div>
                                    <span class="badge @statusBadge rounded-pill">@ticket.Status</span>
                                </div>

                                <p class="mb-2" style="font-size:.875rem;color:var(--nfa-muted-fg);line-height:1.6;">@ticket.Message</p>

                                @if (!string.IsNullOrEmpty(ticket.AdminResponse))
                                {
                                    <div class="p-3 mt-2" style="background:oklch(0.72 0.19 155 / .08);border-radius:var(--nfa-radius);border:1px solid oklch(0.72 0.19 155 / .15);">
                                        <small class="fw-semibold" style="color:oklch(0.55 0.17 155);"><i class="bi bi-reply me-1"></i>Admin Yanıtı:</small>
                                        <p class="mb-0 mt-1" style="font-size:.8125rem;">@ticket.AdminResponse</p>
                                        @if (ticket.ResponseDate != null)
                                        {
                                            <small class="text-nfa-muted">@ticket.ResponseDate?.ToString("dd MMM yyyy HH:mm")</small>
                                        }
                                    </div>
                                }

                                <div class="mt-3">
                                    <small class="text-nfa-muted"><i class="bi bi-clock me-1"></i>@ticket.CreatedDate.ToString("dd MMM yyyy HH:mm")</small>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card card-nfa-shadow nfa-animate-in">
                <div class="card-body text-center py-5">
                    <i class="bi bi-inbox" style="font-size:3rem;color:var(--nfa-muted-fg);"></i>
                    <p class="text-nfa-muted mt-3 mb-3">Henüz bir destek talebiniz bulunmuyor.</p>
                    <button type="button" class="btn btn-nfa-primary px-4" data-bs-toggle="modal" data-bs-target="#createTicketModal">
                        <i class="bi bi-plus-circle me-2"></i>İlk Talebinizi Oluşturun
                    </button>
                </div>
            </div>
        }

        <div class="text-center mt-4">
            <a asp-action="Dashboard" class="nfa-link" style="font-size:.8125rem;"><i class="bi bi-arrow-left me-1"></i>Panelime Dön</a>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/custom-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
}
